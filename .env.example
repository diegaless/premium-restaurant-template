# Optional production canonical origin. Default examples stay noindex.
# SITE_URL=https://www.your-restaurant.com
# Select your own configuration (relative to the project root).
# SITE_CONFIG=template/site-config.js
# Optional subdirectory and output directory (the Pages build sets these).
# SITE_BASE=/oliva/
# SITE_OUTPUT=dist-pages/oliva
# STATIC_HOSTING=true
# PAGES_ORIGIN=https://r1.diegoayala.com
# Persistent server-side newsletter storage. Keep it outside the public web root.
# NEWSLETTER_DATA_FILE=/var/lib/restaurant/subscribers.jsonl
# PORT=4173
# HOST=127.0.0.1
