{
  "name": "restauantes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.html",
  "scripts": {
    "start": "vite",
    "start:template": "vite --mode template --port 5174",
    "build": "vite build",
    "build:template": "vite build --mode template",
    "build:all": "npm run build && npm run build:template",
    "build:pages": "node scripts/build-pages.mjs",
    "check:pages": "node scripts/pages-check.mjs",
    "preview": "vite preview",
    "preview:template": "vite preview --mode template --port 4174",
    "serve": "node scripts/serve.mjs dist",
    "serve:template": "node scripts/serve.mjs dist-template",
    "test": "node --test tests/*.test.mjs",
    "check:flows": "node scripts/flow-check.mjs",
    "check:carousels": "node scripts/carousel-check.mjs",
    "check:links": "node scripts/link-check.mjs",
    "check": "node scripts/visual-check.mjs",
    "check:responsive": "node scripts/responsive-check.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "description": "Configurable premium restaurant website template with reservations, menus, locations and local SEO.",
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "playwright": "^1.60.0",
    "sharp": "^0.35.5",
    "swiper": "^14.3.0",
    "vite": "^7.3.6"
  }
}
